DATABASE_URL=postgresql+asyncpg://graft:graft@db:5432/graft
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-string
ENCRYPTION_KEY=replace-with-a-fernet-key
CORS_ORIGINS=[]
APP_ENV=dev
# Shared by app and worker: the worker re-reads the original on every attempt.
STORAGE_ROOT=/data/uploads
# Proxies allowed to set X-Forwarded-For on the public chat endpoint. Leave empty
# unless Graft sits behind one you control: otherwise a visitor rotates the header
# and gets a fresh rate-limit quota every request.
TRUSTED_PROXY_IPS=[]
